# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
# Gradle's own build output — a problems-report.html from here was tracked by
# mistake and churned on every build.
/android/build/

# Design canvas working files; the canvas itself is published as an Artifact
# and the seeded page is ~2.5 MB of editor payload.
/.design/

# Claude Code session data
.claude/

# Root-level screenshots and temp images
/*.png
/*.jpeg
/*.jpg
index.html
android/.kotlin/

# Firebase iOS config. Kept out of the repository by default — it carries the
# project's iOS API key, and this remote is publicly readable. Re-download it
# from the Firebase console for com.myservices.myservicesTv when setting up a
# new machine; without it the app still builds and runs, it simply has no push.
ios/Runner/GoogleService-Info.plist

# Python test cache from the alert sender
server/match-alerts/.pytest_cache/
server/match-alerts/**/__pycache__/
